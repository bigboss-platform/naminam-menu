# Los Antojitos de Santanita — public site. Copy to .env.local. Everything is OPTIONAL:
# without any variable the site runs fully (static menu, forms in demo mode).

# Public URL (SEO / Open Graph). On Vercel: https://<project>.vercel.app or the real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order / quote / complaint emails through Resend (https://resend.com, free tier).
# Without RESEND_API_KEY nothing is emailed and the success screen says "modo demo".
RESEND_API_KEY=
# Sender — must be a domain verified in Resend. For tests: Santanita <onboarding@resend.dev>
EMAIL_FROM=Santanita <onboarding@resend.dev>
# Who receives the copies (defaults to the business email in business.config.ts)
OWNER_EMAIL=antojitos.santanita@gmail.com

# UI/UX audit helpers (element code tags + outlines). Never true in production.
NEXT_PUBLIC_UI_DEBUG=false

# Home section separation theme: classic | modern | torn
NEXT_PUBLIC_SECTION_THEME=modern
# Local comparison only: live theme switcher (never true in production)
NEXT_PUBLIC_THEME_SWITCHER=false
