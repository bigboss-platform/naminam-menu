# Optional — without these the site serves the built-in menu (src/features/menu/data/menu.data.ts).

# Same MongoDB the back office uses (read-only use here). Never prefix with NEXT_PUBLIC_.
MONGODB_URI=mongodb://naminam:naminam-dev@localhost:27017/?authSource=admin
MONGODB_DB=naminam

# Shared secret for POST /api/revalidate (the back office calls it after every save).
# Must match LANDING_REVALIDATE_SECRET in naminam/backoffice-app/.env.local
REVALIDATE_SECRET=replace-with-a-long-random-string

# UI/UX audit helpers (element code tags + outlines). Never true in production.
NEXT_PUBLIC_UI_DEBUG=false
# Fake "Test N" products added to the home wheel while UI debug is on (stress test).
NEXT_PUBLIC_UI_DEBUG_WHEEL_EXTRA_ITEMS=0
